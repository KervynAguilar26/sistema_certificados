# Copia este archivo a .env y ajusta los valores.
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=1

# Dominios permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Orígenes confiables para CSRF (incluye esquema), separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL pública usada en los códigos QR. Sin barra final.
SITE_BASE_URL=http://127.0.0.1:8000

# Ruta secreta del panel administrativo. Debe terminar en /.
ADMIN_URL_PATH=control/

# PostgreSQL
POSTGRES_DB=qtech_certificates
POSTGRES_USER=qtech_user
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Usa SQLite solo para pruebas rápidas sin PostgreSQL (no recomendado en producción).
USE_SQLITE=0

# Confiar en cabeceras del proxy inverso (Nginx/Traefik) para HTTPS e IP real.
TRUST_PROXY_HEADERS=0

# Correo (opcional). En desarrollo se imprime en consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@qtecheni.com
CONTACT_EMAIL=info@qtecheni.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1

# Base de datos antigua del sistema PHP (para importar datos).
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=5432
LEGACY_DB_NAME=certificaciones_db
LEGACY_DB_USER=postgres
LEGACY_DB_PASSWORD=cambia-esta-contrasena
